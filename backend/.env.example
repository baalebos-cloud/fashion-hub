# Copy this file to .env and fill in real values. Never commit .env.
#
# PRODUCTION CHECKLIST — set these before going live:
#   [ ] APP_ENV=production, DEBUG=false (disables /docs and /redoc)
#   [ ] SECRET_KEY — a fresh random value, not the placeholder below
#   [ ] DATABASE_URL — a real Postgres instance with PostGIS, strong password
#   [ ] CORS_ALLOWED_ORIGINS — your actual frontend domain(s), never "*"
#   [ ] PAYMENT_* — live (not test) keys once you're ready to accept real payments
#   [ ] MAPS_API_KEY — restricted by server IP (see the Maps section below)
#   [ ] EMAIL_* — a real SMTP relay, not the localhost default
#   [ ] STORAGE_PROVIDER — anything but "local" (which writes to /tmp)
#   [ ] AI_API_KEY — from console.anthropic.com

# --- Application ---
APP_ENV=development
APP_NAME=Fashion Hub
APP_URL=http://localhost:8000
API_PREFIX=/api/v1
DEBUG=true

# --- Database ---
DATABASE_URL=postgresql+psycopg://fashionhub:fashionhub@localhost:5432/fashionhub
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Authentication / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# or: openssl rand -hex 32
# Never reuse the placeholder below — every environment (dev, staging,
# prod) should have its own random value, and rotating it invalidates
# every issued token, logging everyone out.
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# Comma-separated. In production this must be your actual frontend
# origin(s) — never "*" once credentials/bearer tokens are in play.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WEBHOOK=60/minute

# --- Payments ---
# Paystack: dashboard.paystack.com > Settings > API Keys & Webhooks
#   PAYMENT_SECRET_KEY    = the "Secret Key" (sk_live_... in production, sk_test_... for testing)
#   PAYMENT_PUBLIC_KEY    = the "Public Key" (pk_live_.../pk_test_...) — also goes in frontend's VITE_PAYMENT_PUBLIC_KEY
#   PAYMENT_WEBHOOK_SECRET = set a webhook URL to https://yourdomain.com/api/v1/payments/webhooks/paystack
#                            in the same dashboard page; Paystack signs webhooks with your secret key
#                            itself (see PaystackProvider.verify_webhook_signature) — no separate value to copy here.
# Flutterwave: dashboard.flutterwave.com > Settings > API
#   Same idea: secret key, public key, and a webhook "secret hash" you set
#   yourself in the dashboard and mirror here as PAYMENT_WEBHOOK_SECRET.
PAYMENT_PROVIDER=paystack
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Maps ---
# Server-side key for Geocoding + Distance Matrix APIs (NOT the same key
# as the frontend's VITE_MAPS_PUBLIC_KEY, which only renders a map).
#   1. console.cloud.google.com -> same project as the frontend key (or a
#      separate one — either works) -> enable billing if not already
#   2. APIs & Services > Library > enable "Geocoding API" and
#      "Distance Matrix API" (do NOT enable Maps JavaScript API on this key)
#   3. APIs & Services > Credentials > Create Credentials > API key
#   4. Edit the key > "Application restrictions" > IP addresses > add your
#      backend server's outbound IP (find it with `curl ifconfig.me` on
#      the server, or your host's static IP if using a VPS)
#   5. "API restrictions" > restrict key > select Geocoding API +
#      Distance Matrix API only
# Restricting by server IP (not HTTP referrer) is correct here since this
# key is only ever called from your backend, never a browser.
MAP_PROVIDER=google_maps
MAPS_API_KEY=

# --- Delivery ---
DELIVERY_PROVIDER=internal
DELIVERY_API_KEY=
DELIVERY_WEBHOOK_SECRET=

# --- KYC / KYB ---
KYC_PROVIDER=manual
KYC_API_KEY=

# --- AI Assistant ---
# console.anthropic.com > Settings > API Keys > Create Key
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6

# --- Notifications ---
# EMAIL_HOST/PORT/USERNAME/PASSWORD are for a real SMTP relay (e.g.
# Postmark, SendGrid, Amazon SES, or your own mail server) — the code no
# longer hardcodes localhost:587. Postmark/SendGrid both give you an SMTP
# username+password pair on their dashboard; EMAIL_API_KEY is unused by
# the current SMTP integration and reserved for a future HTTP-API-based
# provider.
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@fashionhub.example
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
SMS_PROVIDER=
SMS_API_KEY=
PUSH_PROVIDER=

# --- Object storage ---
# STORAGE_PROVIDER=local is DEV-ONLY (writes to /tmp on the server — never
# use in production, see app/integrations/storage/object_storage.py).
# For production, set STORAGE_PROVIDER to anything else (the code treats
# "not local" as S3-compatible) and point at any S3-compatible provider:
# MinIO (self-hosted), Backblaze B2, DigitalOcean Spaces, Hetzner Object
# Storage, or AWS S3 itself.
#   STORAGE_BUCKET            = your bucket name
#   STORAGE_ENDPOINT          = e.g. https://s3.us-west-002.backblazeb2.com
#   STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY = from your provider's dashboard
#   STORAGE_PUBLIC_BASE_URL   = the public URL prefix for public-read objects
#                               (profile photos, portfolio images) — leave
#                               unset if serving everything via signed URLs
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Weather (delivery-time forecasts) ---
# openweathermap.org > API keys tab (free tier covers One Call API 3.0 at
# low volume; check current pricing before high-traffic production use)
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=

# --- NIN identity verification (compulsory KYC) ---
# "manual" blocks all NIN submission with a clear error until a real
# provider is configured -- there is no unverified fallback. Get NIN
# lookup access from Prembly (prembly.com), Youverify, QoreID, VerifyMe,
# or Smile ID -- all serve the Nigerian NIN verification market.
NIN_PROVIDER=manual
NIN_API_KEY=

# --- WhatsApp notifications (vendor <-> tailor/designer order updates) ---
# Option A: Meta WhatsApp Cloud API (developers.facebook.com/docs/whatsapp/cloud-api)
#   WHATSAPP_PROVIDER=meta_cloud_api, WHATSAPP_API_KEY=<permanent access token>,
#   WHATSAPP_FROM_NUMBER=<your WhatsApp Business phone number ID>
# Option B: Twilio (twilio.com/whatsapp)
#   WHATSAPP_PROVIDER=twilio, WHATSAPP_API_KEY=<auth token>,
#   WHATSAPP_FROM_NUMBER=<Account SID>
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# --- Platform economics ---
# 15% platform commission, deducted from what the seller nets -- never
# shown to the customer (see docs/commission.md). Do not lower this via
# env var without also updating whatever you've told professionals/vendors
# during onboarding negotiation.
PLATFORM_COMMISSION_RATE=0.15
# Referrer's share of the PLATFORM's commission (not of the order total)
# on their referred signup's first paid order. See docs/referrals.md.
REFERRAL_COMMISSION_SHARE=0.20
