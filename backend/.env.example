# Copy this file to .env and fill in real values. Never commit .env.
#
# PRODUCTION CHECKLIST — set these before going live:
#   [ ] APP_ENV=production, DEBUG=false (disables /docs and /redoc)
#   [ ] SECRET_KEY — a fresh random value, not the placeholder below
#   [ ] DATABASE_URL — a real Postgres instance with PostGIS, strong password
#   [ ] CORS_ALLOWED_ORIGINS — your actual frontend domain(s), never "*"
#   [ ] PAYMENT_* — live (not test) keys once you're ready to accept real payments
#   [ ] MAPS_API_KEY — restricted by server IP (see the Maps section below)
#   [ ] EMAIL_* — a real SMTP relay, not the localhost default
#   [ ] STORAGE_PROVIDER — anything but "local" (which writes to /tmp)
#   [ ] AI_API_KEY — from console.anthropic.com

# --- Application ---
APP_ENV=development
APP_NAME=Fashion Hub
APP_URL=http://localhost:8005
# Absolute browser origin for verification and password reset links.
# Use your HTTPS customer-facing domain in staging/production.
FRONTEND_URL=http://localhost:5173
API_PREFIX=/api/v1
DEBUG=true

# --- Database ---
# Copy the complete provider URI; postgres:// and postgresql:// select psycopg automatically.
# Use a numeric port or omit both colon and port; HOST:/DATABASE is invalid.
# URL-encode credentials when constructing a URI. Never expose this as a VITE_* variable.
# Railway setup and troubleshooting: deployment/railway.md
DATABASE_URL=postgresql+psycopg://fashionhub:fashionhub@localhost:5432/fashionhub
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_ECHO=false

# --- Redis ---
REDIS_URL=redis://localhost:6379/0

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Authentication / JWT ---
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# or: openssl rand -hex 32
# Never reuse the placeholder below — every environment (dev, staging,
# prod) should have its own random value, and rotating it invalidates
# every issued token, logging everyone out.
SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
PASSWORD_RESET_TOKEN_EXPIRE_MINUTES=30
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# --- CORS ---
# JSON array. In production this must be your actual frontend
# origin(s) — never "*" once credentials/bearer tokens are in play.
CORS_ALLOWED_ORIGINS=["http://localhost:5173"]

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=10/minute
RATE_LIMIT_WEBHOOK=60/minute
# Production/staging: redis://... or rediss://... shared by all API workers
RATE_LIMIT_STORAGE_URI=memory://

# --- Material checkout ---
# Unpaid stock holds, 1–120 minutes. Run beat and the payments worker queue.
VENDOR_RESERVATION_TTL_MINUTES=15

# --- Payments ---
# Paystack: dashboard.paystack.com > Settings > API Keys & Webhooks
#   PAYMENT_SECRET_KEY    = the "Secret Key" (sk_live_... in production, sk_test_... for testing)
#   PAYMENT_PUBLIC_KEY    = the "Public Key" (pk_live_.../pk_test_...) — also goes in frontend's VITE_PAYMENT_PUBLIC_KEY
#   PAYMENT_WEBHOOK_SECRET = set a webhook URL to https://yourdomain.com/api/v1/payments/webhooks/paystack
#                            in the same dashboard page; Paystack signs webhooks with your secret key
#                            itself (see PaystackProvider.verify_webhook_signature) — no separate value to copy here.
# Flutterwave: dashboard.flutterwave.com > Settings > API
#   Same idea: secret key, public key, and a webhook "secret hash" you set
#   yourself in the dashboard and mirror here as PAYMENT_WEBHOOK_SECRET.
PAYMENT_PROVIDER=paystack
PAYMENT_SECRET_KEY=
PAYMENT_PUBLIC_KEY=
PAYMENT_WEBHOOK_SECRET=

# --- Maps ---
# Server-side key for Geocoding + Distance Matrix APIs (NOT the same key
# as the frontend's VITE_MAPS_PUBLIC_KEY, which only renders a map).
#   1. console.cloud.google.com -> same project as the frontend key (or a
#      separate one — either works) -> enable billing if not already
#   2. APIs & Services > Library > enable "Geocoding API" and
#      "Distance Matrix API" (do NOT enable Maps JavaScript API on this key)
#   3. APIs & Services > Credentials > Create Credentials > API key
#   4. Edit the key > "Application restrictions" > IP addresses > add your
#      backend server's outbound IP (find it with `curl ifconfig.me` on
#      the server, or your host's static IP if using a VPS)
#   5. "API restrictions" > restrict key > select Geocoding API +
#      Distance Matrix API only
# Restricting by server IP (not HTTP referrer) is correct here since this
# key is only ever called from your backend, never a browser.
MAP_PROVIDER=google_maps
MAPS_API_KEY=

# --- Delivery ---
DELIVERY_PROVIDER=internal
DELIVERY_API_KEY=
DELIVERY_WEBHOOK_SECRET=

# --- KYC / KYB ---
KYC_PROVIDER=manual
KYC_API_KEY=

# --- AI Assistant ---
# For Anthropic use AI_PROVIDER=anthropic, AI_API_KEY, and Claude AI_MODEL.
# For Google Cloud Vertex AI EXPRESS MODE use:
#   AI_PROVIDER=vertex_ai
#   VERTEX_AI_ENABLED=true
#   VERTEX_AI_MODEL_NAME=gemini-1.5-flash
#   VERTEX_AI_API_KEY=<express-mode API key, stored privately in Railway>
# For Gemini Developer API (AI Studio, easiest for dev/hackathon):
#   AI_PROVIDER=vertex_ai
#   VERTEX_AI_ENABLED=true
#   GEMINI_API_KEY=<key from aistudio.google.com/app/apikey>
# Valid model names: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
# Never expose any of these secret keys in VITE_* frontend environment variables.
AI_PROVIDER=anthropic
AI_API_KEY=
AI_MODEL=claude-sonnet-4-6
VERTEX_AI_API_KEY=
GEMINI_API_KEY=

# --- Notifications ---
# EMAIL_HOST/PORT/USERNAME/PASSWORD are for a real SMTP relay (e.g.
# Postmark, SendGrid, Amazon SES, or your own mail server) — the code no
# longer hardcodes localhost:587. Postmark/SendGrid both give you an SMTP
# username+password pair on their dashboard; EMAIL_API_KEY is unused by
# the current SMTP integration and reserved for a future HTTP-API-based
# provider.
EMAIL_PROVIDER=smtp
EMAIL_API_KEY=
EMAIL_FROM_ADDRESS=no-reply@fashionhub.example
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_USE_TLS=true
SMS_PROVIDER=
SMS_API_KEY=
PUSH_PROVIDER=

# --- Object storage ---
# STORAGE_PROVIDER=local is DEV-ONLY (writes to /tmp on the server — never
# use in production, see app/integrations/storage/object_storage.py).
# For production, set STORAGE_PROVIDER to anything else (the code treats
# "not local" as S3-compatible) and point at any S3-compatible provider:
# MinIO (self-hosted), Backblaze B2, DigitalOcean Spaces, Hetzner Object
# Storage, or AWS S3 itself.
#   STORAGE_BUCKET            = your bucket name
#   STORAGE_ENDPOINT          = e.g. https://s3.us-west-002.backblazeb2.com
#   STORAGE_ACCESS_KEY / STORAGE_SECRET_KEY = from your provider's dashboard
#   STORAGE_PUBLIC_BASE_URL   = the public URL prefix for public-read objects
#                               (profile photos, portfolio images) — leave
#                               unset if serving everything via signed URLs
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PUBLIC_BASE_URL=

# --- Pagination ---
DEFAULT_PAGE_SIZE=20
MAX_PAGE_SIZE=100

# --- Weather (delivery-time forecasts) ---
# openweathermap.org > API keys tab (free tier covers One Call API 3.0 at
# low volume; check current pricing before high-traffic production use)
WEATHER_PROVIDER=openweathermap
WEATHER_API_KEY=

# --- NIN identity verification (compulsory KYC) ---
# "manual" holds every submission for an admin to check by hand; nothing is
# verified without a real lookup. Dojah (dojah.io) and Prembly (prembly.com)
# are implemented; see backend/docs/nin-verification.md.
# manual | dojah | prembly. NIN_API_KEY is the provider's secret key.
NIN_PROVIDER=manual
NIN_API_KEY=
# Dojah only: App ID from the Dojah dashboard; sandbox https://sandbox.dojah.io, live https://api.dojah.io
DOJAH_APP_ID=
DOJAH_BASE_URL=https://api.dojah.io
# Approve identity checks automatically when every rule passes (docs/nin-verification.md). Keep false until tested.
NIN_AUTO_APPROVE=false

# --- WhatsApp notifications (vendor <-> tailor/designer order updates) ---
# Option A: Meta WhatsApp Cloud API (developers.facebook.com/docs/whatsapp/cloud-api)
#   WHATSAPP_PROVIDER=meta_cloud_api, WHATSAPP_API_KEY=<permanent access token>,
#   WHATSAPP_FROM_NUMBER=<your WhatsApp Business phone number ID>
# Option B: Twilio (twilio.com/whatsapp)
#   WHATSAPP_PROVIDER=twilio, WHATSAPP_API_KEY=<auth token>,
#   WHATSAPP_FROM_NUMBER=<Account SID>
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_FROM_NUMBER=

# --- Platform economics ---
# 15% platform commission, deducted from what the seller nets -- never
# shown to the customer (see docs/commission.md). Do not lower this via
# env var without also updating whatever you've told professionals/vendors
# during onboarding negotiation.
PLATFORM_COMMISSION_RATE=0.15
# Referrer's share of the PLATFORM's commission (not of the order total)
# on their referred signup's first paid order. See docs/referrals.md.
REFERRAL_COMMISSION_SHARE=0.20

# Required before accepting KYC: dedicated Fernet key, stored in your secret manager.
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
IDENTITY_ENCRYPTION_KEY=

# --- Interswitch Hackathon (SANDBOX ONLY) ---
# Disabled by default; no live checkout path is exposed by this feature.
# APP_URL must be the public HTTPS backend address for browser POST returns.
INTERSWITCH_SANDBOX_ENABLED=false
INTERSWITCH_MERCHANT_CODE=
INTERSWITCH_PAY_ITEM_ID=

# --- Vertex AI (ADC/workload identity preferred; never commit service-account JSON) ---
# To use Vertex AI, set VERTEX_AI_ENABLED=true and supply ONE of:
#   Option A — Gemini Developer API key (AI Studio, easiest for dev/hackathon):
#     GEMINI_API_KEY=<key from aistudio.google.com/app/apikey>
#   Option B — Vertex AI Express Mode key (GCP console):
#     VERTEX_AI_API_KEY=<express-mode key>
#   Option C — GCP service account (production workloads):
#     GCP_PROJECT_ID=your-gcp-project-id
#     GCP_SERVICE_ACCOUNT_JSON=<single-line JSON of the service account key file>
#     (generate key: GCP console > IAM > Service Accounts > Keys > Add Key > JSON)
# Valid model names: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
VERTEX_AI_ENABLED=false
GCP_PROJECT_ID=
GCP_REGION=us-central1
GEMINI_API_KEY=
VERTEX_AI_API_KEY=
GCP_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/secure/path/to/service-account.json
VERTEX_AI_MODEL_NAME=gemini-1.5-flash
# Groq fallback when Vertex AI is unavailable (chat and photo measurements).
AI_FALLBACK_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
# Must be a vision-capable Groq model; used to draft measurements from photos.
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Business verification (KYB) via Prembly CAC lookup ---
# "manual" sends every KYB to admin review; "prembly" checks the CAC register first.
KYB_PROVIDER=manual
# Defaults to NIN_API_KEY (same Prembly account) when empty.
PREMBLY_API_KEY=
# Confirm the current CAC endpoint in Prembly's Verification Services Directory.
PREMBLY_CAC_URL=https://api.prembly.com/verification/cac/advance

# --- Auto-dispatch (sequential rider offers). Off by default; see docs/logistics-audit.md ---
# When true, each new job is offered to the nearest eligible rider with an exclusive
# window, then the next; after MAX_ATTEMPTS it stays on the open job board.
# Requires the Celery beat process (advance-expired-job-offers runs every 15 s).
DISPATCH_AUTO_OFFER_ENABLED=false
DISPATCH_AUTO_OFFER_TTL_SECONDS=90
DISPATCH_AUTO_OFFER_MAX_ATTEMPTS=5
DISPATCH_AUTO_OFFER_RADIUS_KM=20

# --- Shareable recipient tracking links ---
TRACKING_LINK_TTL_HOURS=168
TRACKING_LINK_AFTER_DELIVERY_HOURS=48
TRACKING_LINK_MAX_ACTIVE=3

# --- Delivery proof (one-time pickup/handover codes) ---
# Codes are never stored; they expire, rotate on request and work once.
HANDOVER_CODE_TTL_MINUTES=30
PICKUP_CODE_TTL_MINUTES=30
# Seller gives the rider a pickup code at collection. Set false to skip it during rollout.
DELIVERY_PICKUP_CODE_REQUIRED=true

# --- Admin access ---
# Only these emails can use the admin area (comma-separated). Empty in production = nobody.
ADMIN_EMAILS=you@example.com
ADMIN_TOTP_ISSUER=Tailora Admin
# Behind Railway's proxy: read the real client IP from the proxy headers.
TRUST_PROXY_HEADERS=true
# Sign-in and change history (IP, device) is kept this many days.
ACTIVITY_LOG_RETENTION_DAYS=180

# --- Road routing (see docs/logistics-routing.md) ---
ROUTING_PROVIDER=none
ROUTING_GOOGLE_API_KEY=
ROUTING_OSRM_URL=
ROUTING_TIMEOUT_SECONDS=3
ROUTING_LIVE_ETA_SECONDS=60
DISPATCH_PRICE_FROM_ROAD_ROUTES=false

# --- Buyer alerts from the rider's shared GPS ---
DELIVERY_PROXIMITY_ALERTS_ENABLED=true
DELIVERY_APPROACH_ALERT_MINUTES=5
DELIVERY_ARRIVAL_RADIUS_M=150

# --- Masked voice calls (Africa's Talking) ---
# Customers, tailors, vendors and riders call each other through Tailora's
# number; nobody sees the other's real number. See docs/masked-calls.md.
# VOICE_PROVIDER: empty = calling off, "sandbox" = fake provider for local
# testing, "africastalking" = live.
VOICE_PROVIDER=
AT_USERNAME=
AT_API_KEY=
AT_VOICE_NUMBER=
AT_ENVIRONMENT=sandbox
# Long random string; it is part of the callback URL you set in Africa's Talking.
VOICE_WEBHOOK_SECRET=
VOICE_CALLBACK_WINDOW_HOURS=2
VOICE_MAX_CALL_SECONDS=900

# --- Hackathon live IPG (separate from staging; disabled by default) ---
# Set ONLY on the approved production hackathon service after team assignment.
# Hosted checkout only; never accept card details in Seam.
INTERSWITCH_LIVE_ENABLED=false
INTERSWITCH_LIVE_MERCHANT_CODE=
INTERSWITCH_LIVE_PAY_ITEM_ID=
