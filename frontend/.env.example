# Copy to .env.local for development. Never commit real values.

VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="Fashion Hub"
VITE_APP_ENV=development

# Maps (client-side map rendering only; geocoding/distance calls still go
# through the backend's MapProvider abstraction, never called directly
# from the browser with a server-side secret key)
VITE_MAPS_PROVIDER=google_maps
VITE_MAPS_PUBLIC_KEY=

# Payments (public/publishable key only — never the secret key)
VITE_PAYMENT_PROVIDER=paystack
VITE_PAYMENT_PUBLIC_KEY=

# Feature flags
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_MESSAGING=true
