# Copy this file to .env.local for development. Never commit real values.

VITE_API_BASE_URL=/api/v1
VITE_APP_NAME="Fashion Hub"
VITE_APP_ENV=development

# --- Maps ---
# Client-side map RENDERING key only (Maps JavaScript API). This is
# different from the backend's MAPS_API_KEY, which does geocoding/distance
# calls server-side. Get this key from Google Cloud Console:
#   1. console.cloud.google.com -> select/create a project -> enable billing
#   2. APIs & Services > Library > enable "Maps JavaScript API"
#      (only this one — do NOT enable Geocoding/Distance Matrix on this key)
#   3. APIs & Services > Credentials > Create Credentials > API key
#   4. Edit the key > "Application restrictions" > HTTP referrers >
#      add your domain(s), e.g. https://yourdomain.com/* and
#      http://localhost:5173/* for local dev
#   5. "API restrictions" > restrict key > select only Maps JavaScript API
# This key is safe to expose in the browser bundle BECAUSE it's
# referrer-restricted — it will simply fail on any other domain.
VITE_MAPS_PROVIDER=google_maps
VITE_MAPS_PUBLIC_KEY=

# --- Payments ---
# The PUBLIC/publishable key only (starts with pk_ for Paystack) — never
# the secret key, which lives exclusively in the backend's .env.
VITE_PAYMENT_PROVIDER=paystack
VITE_PAYMENT_PUBLIC_KEY=

# --- Feature flags ---
VITE_ENABLE_AI_ASSISTANT=true
VITE_ENABLE_MESSAGING=true
